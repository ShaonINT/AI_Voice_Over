# ---------------------------------------------------------------------------
# Voice Clone Studio — .gitignore
# ---------------------------------------------------------------------------

# === NEVER COMMIT — privacy critical ===
# Voice samples are biometric data. Keep them local, never push to GitHub.
samples/*
!samples/.gitkeep

# Generated audio (often contains real names, scripts in progress, etc.)
output/*
!output/.gitkeep

# === Python bytecode / build artifacts ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# === Virtual environments ===
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# === Testing / coverage ===
.coverage
.coverage.*
.cache
htmlcov/
.tox/
.nox/
.pytest_cache/
.hypothesis/
nosetests.xml
coverage.xml
*.cover

# === Type checkers / linters ===
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# === IDEs / editors ===
.vscode/
.idea/
*.swp
*.swo
*.swn

# === macOS ===
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# === Secrets / environment ===
.env
.env.local
.env.*.local
.envrc
*.key
*.pem

# === Model caches (in case a future version stores them in-project) ===
hf_cache/
.cache/
models/

# === Gradio / logs / temp ===
gradio_cached_examples/
flagged/
*.log
*.tmp
